# /etc/default/grub — installed by archcloud.
# arch-server-bootstrap.sh later sets GRUB_DEFAULT=saved and pins the
# linux-cachyos-server entry with grub-set-default.
GRUB_DEFAULT=0
GRUB_SAVEDEFAULT=false
GRUB_TIMEOUT=3
GRUB_TIMEOUT_STYLE=menu
GRUB_DISTRIBUTOR="Arch"
GRUB_CMDLINE_LINUX_DEFAULT="loglevel=3 console=tty0 console=ttyS0,115200n8"
GRUB_CMDLINE_LINUX=""
GRUB_PRELOAD_MODULES="part_gpt part_msdos"
GRUB_TERMINAL="console serial"
GRUB_SERIAL_COMMAND="serial --unit=0 --speed=115200"
GRUB_GFXMODE=auto
GRUB_GFXPAYLOAD_LINUX=keep
GRUB_DISABLE_RECOVERY=true
GRUB_DISABLE_OS_PROBER=true
# grub-btrfs adds the snapshot submenu through /etc/grub.d/41_snapshots-btrfs
GRUB_BTRFS_LIMIT="20"

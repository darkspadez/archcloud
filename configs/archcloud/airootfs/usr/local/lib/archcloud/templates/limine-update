#!/usr/bin/env bash
#
# limine-update — keep Limine's boot entries and binaries in sync with /boot.
# Installed by archcloud; run by the 95-limine-update pacman hook after kernel,
# microcode or limine changes, by the installer, and by arch-server-bootstrap.
#
#   limine-update            regenerate limine.conf, redeploy binaries
#   limine-update --bios     also (re)install the BIOS boot sector
#
# Layout: /boot is the FAT32 ESP (Limine reads only FAT/ISO9660, so kernels and
# initramfs live there). Config: /boot/limine/limine.conf; BIOS stage 2:
# /boot/limine/limine-bios.sys; UEFI: /boot/EFI/BOOT/BOOTX64.EFI (removable path,
# no NVRAM entry needed, works in a chroot and survives firmware resets).
# Settings: /etc/default/limine-update. BIOS target: /etc/limine-bios-install
# ("<disk> <bios-boot partition number>").
set -Eeuo pipefail

BOOT=${LIMINE_BOOT:-/boot}
FSTAB=${LIMINE_FSTAB:-/etc/fstab}
TIMEOUT=3
EXTRA_CMDLINE="loglevel=3"
SERIAL=yes
# shellcheck disable=SC1091
[[ -r /etc/default/limine-update ]] && . /etc/default/limine-update

DO_BIOS=0
[[ "${1:-}" == --bios ]] && DO_BIOS=1

die() { printf 'limine-update: %s\n' "$*" >&2; exit 1; }
say() { printf 'limine-update: %s\n' "$*"; }

[[ "$(findmnt -no FSTYPE "$BOOT" 2>/dev/null || true)" == vfat ]] \
  || die "$BOOT is not a mounted FAT filesystem (the ESP must be mounted at /boot)"

# --- binaries ---------------------------------------------------------------------
SHARE=/usr/share/limine
[[ -r $SHARE/BOOTX64.EFI && -r $SHARE/limine-bios.sys ]] || die "limine package files missing in $SHARE"
install -d "$BOOT/limine" "$BOOT/EFI/BOOT"
same() { [[ -f "$2" && "$(sha256sum <"$1")" == "$(sha256sum <"$2")" ]]; }
same "$SHARE/BOOTX64.EFI" "$BOOT/EFI/BOOT/BOOTX64.EFI" || { install -m644 "$SHARE/BOOTX64.EFI" "$BOOT/EFI/BOOT/BOOTX64.EFI"; say "updated BOOTX64.EFI"; }
if ! same "$SHARE/limine-bios.sys" "$BOOT/limine/limine-bios.sys"; then
  install -m644 "$SHARE/limine-bios.sys" "$BOOT/limine/limine-bios.sys"; say "updated limine-bios.sys"; DO_BIOS=1
fi
if (( DO_BIOS )) && [[ -r /etc/limine-bios-install ]]; then
  read -r bios_disk bios_part < /etc/limine-bios-install
  if [[ -b "$bios_disk" || -f "$bios_disk" ]]; then
    limine bios-install "$bios_disk" "$bios_part" >/dev/null && say "BIOS boot sector installed on $bios_disk (stage 2 in partition $bios_part)"
  else
    say "WARNING: $bios_disk is not a block device here; BIOS boot sector not refreshed" >&2
  fi
fi

# --- root filesystem spec from fstab --------------------------------------------------
read -r root_spec root_opts < <(awk '$0 !~ /^[[:space:]]*#/ && $2 == "/" {print $1, $4; exit}' "$FSTAB")
[[ -n "${root_spec:-}" ]] || die "no root entry in $FSTAB"
cmdline="root=$root_spec rw"
subvol=$(grep -oE 'subvol=[^,]+' <<<"${root_opts:-}" | head -n1 || true)
[[ -n "$subvol" ]] && cmdline+=" rootflags=$subvol"
[[ -n "$EXTRA_CMDLINE" ]] && cmdline+=" $EXTRA_CMDLINE"

# --- kernels: cachyos-server first, stock linux last ------------------------------------
mapfile -t kernels < <(
  for f in "$BOOT"/vmlinuz-*; do [[ -f "$f" ]] && basename "$f"; done | sed 's/^vmlinuz-//' |
  awk '{ p = ($0 == "linux-cachyos-server") ? 0 : ($0 == "linux") ? 9 : 5; print p, $0 }' | sort -k1,1n -k2,2 | cut -d' ' -f2)
(( ${#kernels[@]} )) || die "no kernels in $BOOT"

ucode=()
for u in amd-ucode.img intel-ucode.img; do [[ -f "$BOOT/$u" ]] && ucode+=("$u"); done

tmp=$(mktemp "$BOOT/limine/.limine.conf.XXXXXX")
{
  echo "# Generated by limine-update — edit /etc/default/limine-update instead."
  echo "timeout: $TIMEOUT"
  echo "serial: $SERIAL"
  echo "default_entry: 1"
  echo "interface_branding: archcloud"
  echo
  for k in "${kernels[@]}"; do
    [[ -f "$BOOT/initramfs-$k.img" ]] || { say "skipping $k: no initramfs-$k.img" >&2; continue; }
    echo "/Arch Linux ($k)"
    echo "    protocol: linux"
    echo "    path: boot():/vmlinuz-$k"
    echo "    cmdline: $cmdline"
    for u in "${ucode[@]}"; do echo "    module_path: boot():/$u"; done
    echo "    module_path: boot():/initramfs-$k.img"
    echo
    if [[ -f "$BOOT/initramfs-$k-fallback.img" ]]; then
      echo "/Arch Linux ($k, fallback initramfs)"
      echo "    protocol: linux"
      echo "    path: boot():/vmlinuz-$k"
      echo "    cmdline: $cmdline"
      for u in "${ucode[@]}"; do echo "    module_path: boot():/$u"; done
      echo "    module_path: boot():/initramfs-$k-fallback.img"
      echo
    fi
  done
} > "$tmp"
grep -q '^/Arch Linux' "$tmp" || { rm -f "$tmp"; die "no bootable entry could be generated"; }
chmod 644 "$tmp"; mv -f "$tmp" "$BOOT/limine/limine.conf"
say "wrote $BOOT/limine/limine.conf ($(grep -c '^/Arch Linux' "$BOOT/limine/limine.conf") entries; kernels: ${kernels[*]})"

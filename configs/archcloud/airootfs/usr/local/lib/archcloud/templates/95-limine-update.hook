# Installed by archcloud. Regenerates Limine's entries after kernels, microcode
# or limine itself change. Sorts after mkinitcpio's 90-mkinitcpio-install.hook,
# which installs the kernel and builds the initramfs into /boot.
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/lib/modules/*/vmlinuz

[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Target = limine
Target = amd-ucode
Target = intel-ucode

[Action]
Description = Updating Limine boot entries...
When = PostTransaction
Exec = /usr/local/sbin/limine-update

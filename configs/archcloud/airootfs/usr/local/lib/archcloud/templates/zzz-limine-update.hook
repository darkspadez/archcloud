# Installed by archcloud. Regenerates Limine's entries after kernels, microcode
# or limine itself change. Sorts after mkinitcpio and zz-snap-pac-post so the new snapshot is listed.
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/lib/modules/*/vmlinuz

[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Target = limine
Target = amd-ucode
Target = intel-ucode

[Action]
Description = Updating Limine boot entries...
When = PostTransaction
Exec = /usr/local/sbin/limine-update
